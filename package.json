{
  "name": "fly-md",
  "version": "2.0.1",
  "description": "Ultra-lightweight Tauri v2 Markdown supervisor, Multi-Agent Studio, Evidence-Graded Debate Engine & Epistemic Cache Handoff Hub",
  "main": "dist-electron/main/index.js",
  "author": "FlyMD Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && tauri build"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@codemirror/lang-markdown": "^6.3.2",
