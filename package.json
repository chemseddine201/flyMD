    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@uiw/react-codemirror": "^4.23.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dompurify": "^3.2.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.7",
